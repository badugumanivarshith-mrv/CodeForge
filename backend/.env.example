# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/codeforge_dev

# Redis Connection (Queues, Cache, Leaderboards)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=your-256-bit-secret-here-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-here-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your-cookie-secret-min-32-chars-long

# AI Provider Configurations (Future Extension / Phase 4)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Judge Sandbox Engine Configurations
JUDGE_MAX_CONCURRENCY=4
JUDGE_WORKER_TIMEOUT_MS=10000
JUDGE_DEFAULT_MEMORY_MB=256
